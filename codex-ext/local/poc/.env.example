# Codex PoC — Environment Variables
# Copy this file to .env and fill in your values.

# Required: DashScope API key (for Qwen models)
DASHSCOPE_API_KEY=sk-...

# Optional: Model selection (default: qwen3.7-plus)
# CODEX_MODEL=qwen3.7-plus

# Optional: DashScope compatible API URL
# CODEX_DASHSCOPE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional: Codex home directory (default: .codex-poc-home in PoC dir)
# CODEX_HOME=C:\Users\you\.codex-poc

# Optional: Log level (trace, debug, info, warn, error)
# CODEX_LOG=info

# Optional: Override model context window (tokens)
# CODEX_MODEL_CONTEXT_WINDOW=131072